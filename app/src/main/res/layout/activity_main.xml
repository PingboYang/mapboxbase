<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <!--MapView -->
    <com.mapbox.maps.MapView
        android:id="@+id/mapView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        mapbox_resourceOptions_accessToken="@string/mapbox_access_token" />

    <!-- Zoom Buttons (floating on top right) -->
    <LinearLayout
        android:id="@+id/zoom_buttons_container"
        android:orientation="vertical"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:layout_alignParentEnd="true"
        android:layout_margin="10dp">


        <!-- zoom in or out button -->
        <Button
            android:id="@+id/zoom_in_button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Zoom In"
            android:focusable="false"
            android:focusableInTouchMode="false"
            android:layout_marginBottom="5dp" />

        <Button
            android:id="@+id/zoom_out_button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Zoom Out"
            android:focusable="false"
            android:focusableInTouchMode="false" />
    </LinearLayout>


    <!-- Bottom Controls -->
    <LinearLayout
        android:id="@+id/buttons_container"
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:background="#AAFFFFFF"
        android:padding="10dp">

        <!-- Start location -->
        <AutoCompleteTextView
            android:id="@+id/startLocationEditText"
            android:hint="Start Location"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="text"
            android:imeOptions="actionNext"
            android:nextFocusDown="@+id/destinationEditText"
            android:layout_marginBottom="10dp" />

        <!-- Destination location -->
        <AutoCompleteTextView
            android:id="@+id/destinationEditText"
            android:hint="Destination"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="text"
            android:imeOptions="actionDone"
            android:layout_marginBottom="10dp" />

        <!-- Route Information -->
        <TextView
            android:id="@+id/routeInfoTextView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Route information will appear here"
            android:textSize="14sp"
            android:textColor="#333333"
            android:background="#E8F4FD"
            android:padding="8dp"
            android:layout_marginBottom="10dp"
            android:visibility="gone" />

        <!-- Buttons -->
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal">

            <Button
                android:id="@+id/mapboxRouteButton"
                android:text="Mapbox Route"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="10dp" />

            <Button
                android:id="@+id/safeRouteButton"
                android:text="Safe Route"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="10dp" />

            <Button
                android:id="@+id/startNavigationButton"
                android:text="Start Navigation"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:visibility="gone" />
        </LinearLayout>

        <!-- Navigation Controls -->
        <LinearLayout
            android:id="@+id/navigationControls"
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:layout_marginTop="10dp"
            android:visibility="gone">

            <Button
                android:id="@+id/stopNavigationButton"
                android:text="Stop Navigation"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="10dp" />

            <Button
                android:id="@+id/recenterButton"
                android:text="Recenter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="10dp" />

            <Button
                android:id="@+id/soundButton"
                android:text="🔊"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />
        </LinearLayout>

    </LinearLayout>




</RelativeLayout>